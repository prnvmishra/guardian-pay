# Copy this file to .env and fill in your own values. Never commit .env.

# IBM watsonx.ai (Granite). All three are needed.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional: pin models instead of letting the app pick from your project
# WATSONX_CHAT_MODEL=ibm/granite-3-3-8b-instruct
# WATSONX_VISION_MODEL=meta-llama/llama-3-2-11b-vision-instruct

# Optional backup: Granite running locally with Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=granite3.3:8b
# OLLAMA_VISION_MODEL=granite3.2-vision

# Demo settings
# GUARDIAN_COOLING_SECONDS=120
# GUARDIAN_SIM_INTERVAL=1.2
